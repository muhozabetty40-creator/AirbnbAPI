generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  username      String         @unique
  password      String?
  phone         String
  role          String         @default("guest")
  avatar        String?
  bio           String?
  listings      Listing[]
  bookings      Booking[]
  reviews       Review[]
  sentMessages  Message[]      @relation("sender")
  receivedMessages Message[]   @relation("receiver")
  notifications Notification[]
  createdAt     DateTime       @default(now())

  @@index([name])
  @@index([role])
}

model Listing {
  id            String    @id @default(uuid())
  title         String
  description   String
  location      String
  pricePerNight Float
  guests        Int
  bedrooms      Int?
  bathrooms     Int?
  type          String
  amenities     String[]
  image         String?
  rating        Float?
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  bookings      Booking[]
  reviews       Review[]
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([location])
  @@index([type])
  @@index([pricePerNight])
}

model Booking {
  id        String         @id @default(uuid())
  userId    String
  listingId String
  checkIn   DateTime
  checkOut  DateTime
  guests    Int
  total     Float
  status    String         @default("pending")
  approvedAt DateTime?
  cancelledAt DateTime?
  user      User           @relation(fields: [userId], references: [id])
  listing   Listing        @relation(fields: [listingId], references: [id])
  createdAt DateTime       @default(now())

  @@index([userId])
  @@index([listingId])
  @@index([status])
}

model Review {
  id        String   @id @default(uuid())
  rating    Int
  comment   String
  userId    String
  listingId String
  user      User     @relation(fields: [userId], references: [id])
  listing   Listing  @relation(fields: [listingId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([listingId])
}

model Message {
  id          String   @id @default(uuid())
  senderId    String
  receiverId  String
  content     String
  isRead      Boolean  @default(false)
  sender      User     @relation("sender", fields: [senderId], references: [id])
  receiver    User     @relation("receiver", fields: [receiverId], references: [id])
  createdAt   DateTime @default(now())

  @@index([senderId])
  @@index([receiverId])
  @@index([isRead])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  data      Json?
  isRead    Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}
